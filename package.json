{
  "name": "birthday-surprise-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "typecheck": "tsc -p artifacts/birthday-surprise/tsconfig.json --noEmit",
    "build": "pnpm typecheck && PORT=3000 BASE_PATH=/ pnpm --filter @workspace/birthday-surprise build",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "verify:stickers": "node scripts/verify-stickers.mjs",
    "generate:posters": "node scripts/generate-sticker-posters.mjs"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
